{
  "lint-format-checker": {
    "enabled": true,
    "PostToolUse": [
      {
        "matcher": "replace_file_content|write_to_file|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": ".agents/scripts/lint-format-check.bat",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "spev-auto-verifier": {
    "enabled": true,
    "PostToolUse": [
      {
        "matcher": "replace_file_content|write_to_file|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": ".agents/scripts/spev-auto-verify.bat",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
